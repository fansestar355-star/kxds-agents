# .env - Config Mail Pro BOSS KXDS
# Copie ce fichier en .env et remplis avec ton compte pro

# Gmail exemple (necessite mot de passe d'application, pas ton mot de passe normal)
# Va sur https://myaccount.google.com/apppasswords -> cree un mdp 16 chars
BOSS_SMTP_HOST=smtp.gmail.com
BOSS_SMTP_PORT=587
BOSS_EMAIL=ton.nom.pro@gmail.com
BOSS_APP_PASSWORD=abcd efgh ijkl mnop

# Outlook / Office365
# BOSS_SMTP_HOST=smtp.office365.com
# BOSS_SMTP_PORT=587

# Kabakoo domaine si SMTP propre
# BOSS_SMTP_HOST=smtp.kabakoo.africa
# BOSS_SMTP_PORT=587

# Destinataire par defaut (toi)
BOSS_TO=ton.nom.pro@gmail.com

# Gemini (deja configure)
GEMINI_API_KEY=AQ.Ab8RN6...
